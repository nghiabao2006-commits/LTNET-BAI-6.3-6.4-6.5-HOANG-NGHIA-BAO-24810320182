<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="KaraokeDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=KaraokeDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
