<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Có thể đổi Data Source cho phù hợp với máy đang chạy.
         Ứng dụng tự dò LocalDB, localhost và SQLEXPRESS nếu máy không có instance trên. -->
    <add name="ProjectTaskDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ProjectTaskDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
